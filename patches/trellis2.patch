+    def _run_stage(self, i: int, h: sp.SparseTensor, guide_sub=None, subs: list = None) -> sp.SparseTensor:
+        """Stage i's blocks, ending with its upsampling block (all stages but the last), as in forward."""
+        res = self.blocks[i]
+        for j, block in enumerate(res):
+            if i < len(self.blocks) - 1 and j == len(res) - 1:
+                if self.pred_subdiv:
+                    h, sub = block(h)
+                    subs.append(sub)
+                else:
+                    h = block(h, subdiv=guide_sub)
+            else:
+                h = block(h)
+        return h
+
+    def forward_tiled(self, x: sp.SparseTensor, guide_subs: Optional[list] = None, return_subs: bool = False, split: Optional[int] = None) -> sp.SparseTensor:
+        """
+        Inference forward that runs the stages before `split` on the whole tensor and the remaining stages (the high
+        resolution ones, where activations dominate memory) one spatial tile at a time. Every layer is a 3x3x3 sparse
+        convolution or per-voxel, so a tile whose margin covers the remaining layers' reach gives its core voxels the
+        same neighbourhoods as the whole-tensor pass; only the cores are kept. With return_subs, the subdivisions of
+        the tiled stages come back as one list per tile (in tile order), which a guided decoder consumes in the same
+        tile order, since its voxels at `split` match this decoder's.
+        """
+        n = len(self.blocks)
+        split = n - 2 if split is None else split
+        h = self.from_latent(x).type(self.dtype)
+        subs = []
+        for i in range(split):
+            h = self._run_stage(i, h, guide_subs[i] if guide_subs is not None else None, subs)
+        coords, xyz = h.coords, h.coords[:, 1:]
+        lo, hi = xyz.min(0).values.tolist(), xyz.max(0).values.tolist()
+        T, M, f = self.tile, self.tile_margin, 2 ** (n - 1 - split)
+        feats_out, coords_out, tile_subs, k = [], [], [], 0
+        for tx in range(lo[0], hi[0] + 1, T):
+            for ty in range(lo[1], hi[1] + 1, T):
+                for tz in range(lo[2], hi[2] + 1, T):
+                    core_lo = torch.tensor([tx, ty, tz], device=xyz.device, dtype=xyz.dtype)
+                    core_hi = core_lo + T
+                    if not ((xyz >= core_lo) & (xyz < core_hi)).all(1).any():
+                        continue
+                    idx = ((xyz >= core_lo - M) & (xyz < core_hi + M)).all(1).nonzero()[:, 0]
+                    t = sp.SparseTensor(h.feats[idx], coords[idx])
+                    t._scale = h._scale
+                    tsubs = []
+                    for i in range(split, n):
+                        # the last stage has no upsampling block, so no subdivision to guide
+                        guide = guide_subs[split][k][i - split] if guide_subs is not None and i < n - 1 else None
+                        t = self._run_stage(i, t, guide, tsubs)
+                    t = t.type(x.dtype)
+                    t = t.replace(F.layer_norm(t.feats, t.feats.shape[-1:]))
+                    t = self.output_layer(t)
+                    anc = torch.div(t.coords[:, 1:], f, rounding_mode='floor')
+                    keep = ((anc >= core_lo) & (anc < core_hi)).all(1)
+                    feats_out.append(t.feats[keep])
+                    coords_out.append(t.coords[keep])
+                    tile_subs.append(tsubs)
+                    k += 1
+                    del t
+                    torch.cuda.empty_cache()
+        out = sp.SparseTensor(torch.cat(feats_out), torch.cat(coords_out))
+        out._scale = tuple(s / 2 ** (n - 1) for s in x._scale)
+        if return_subs:
+            return out, subs + [tile_subs]
+        return out
+
