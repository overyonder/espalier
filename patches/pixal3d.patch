+
+def tile_naf_attention(naf_model: nn.Module, tile: int) -> None:
+    """
+    Run NAF's cross-attention in square tiles of `tile` query pixels instead of over the whole output at once.
+
+    NAF enlarges the low-resolution keys and values to the query size by nearest-neighbour copying, then attends
+    over a kernel x kernel neighbourhood at dilation (query size / key size). At a 1024 output with 1024 channels that
+    enlarged value tensor alone is 4 GiB. A query pixel only sees pixels within (kernel // 2) * dilation of itself, so
+    each tile carries that margin, enlarges just its slice of the keys and values, and keeps only its core. Tile edges
+    and margins are multiples of the dilation, so every core pixel attends over exactly the pixels it would in the
+    untiled pass and its neighbourhood is never shifted by a tile edge.
+    """
+    from einops import rearrange
+    attn = naf_model.model.upsampler if hasattr(naf_model, 'model') else naf_model.upsampler
+    untiled = attn.forward
+
+    def forward(q, k, v, image=None, return_weights=False, **kwargs):
+        hq, wq = q.shape[-2:]
+        hk, wk = k.shape[-2:]
+        dy, dx = hq // hk, wq // wk
+        if return_weights or (hq <= tile and wq <= tile) or hq % hk or wq % wk or tile % dy or tile % dx:
+            return untiled(q, k, v, image=image, return_weights=return_weights, **kwargs)
+        my, mx = (attn.kernel_size[0] // 2) * dy, (attn.kernel_size[1] // 2) * dx
+        out = None
+        for y0 in range(0, hq, tile):
+            for x0 in range(0, wq, tile):
+                y1, x1 = min(y0 + tile, hq), min(x0 + tile, wq)
+                ty0, tx0 = max(0, y0 - my), max(0, x0 - mx)
