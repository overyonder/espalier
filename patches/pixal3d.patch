+# Weight streaming. In low-VRAM mode the pipeline moves each network to the GPU for its stage and back with .cpu(),
+# which keeps every network's weights in anonymous process memory: about 16 GB that the kernel can only swap. A streamed
+# network keeps no host copy of the weights it loaded from its file. `.cpu()` frees its weights and `.to(cuda)` reloads
+# them from the file. File reads go through the page cache, so recently used weights
+# stay in RAM while there is room and the kernel drops them for free under pressure, leaving the file as the last tier.
+# With TRELLIS_KEEP_IDLE_ON_GPU=1, `.cpu()` instead leaves the network resident, and before a network loads, idle
+# resident networks are freed, least recently used first, until the GPU has the network's size plus
+# TRELLIS_VRAM_HEADROOM_GIB (default 10) free for the stage's working memory. The weights are the file's, so
+# results are unchanged. TRELLIS_STREAM_WEIGHTS=0 restores the original behaviour.
+
+_idle_gpu_networks = []   # Streamed networks resident on the GPU but not in use, least recently used first
+
+
+def stream_weights_from_file(model, model_file: str) -> None:
+    import os
+    import types
+    import torch
+    from safetensors import safe_open
+    with safe_open(model_file, framework='pt') as weights:
+        in_file = set(weights.keys())
+    streamed = {name for name, _ in model.named_parameters() if name in in_file}
+    model._streamed_file = model_file
+    model._streamed_names = streamed
+    model._streamed_bytes = sum(p.numel() * p.element_size() for name, p in model.named_parameters() if name in streamed)
+    model._streamed_device = None   # The GPU holding the weights, or None when they are only in the file
+    _free_streamed_weights(model)
+    original_to = model.to
+
+    def to(self, *args, **kwargs):
+        device, _, _, _ = torch._C._nn._parse_to(*args, **kwargs)
+        if device is None:
+            return original_to(*args, **kwargs)
+        if device.type != 'cuda':
+            # Offloading: nothing is copied to the host. The weights are freed, leaving the small buffers on the GPU;
+            # with TRELLIS_KEEP_IDLE_ON_GPU=1 they stay resident until _make_room_on_gpu needs the room. That is only
+            # safe when every large allocation is a streamed network's load: a stage's own working memory, or a model
+            # loaded another way (an image encoder), doesn't trigger the freeing.
+            if self._streamed_device is not None and self not in _idle_gpu_networks:
+                if os.environ.get('TRELLIS_KEEP_IDLE_ON_GPU') == '1':
+                    _idle_gpu_networks.append(self)
+                else:
+                    # The freed blocks stay in PyTorch's cache for the next stage to reuse; returning them to the
+                    # driver here raised the texture decoder's peak by about 1 GiB at 1536.
+                    _free_streamed_weights(self)
+            return self
+        if self in _idle_gpu_networks:
+            _idle_gpu_networks.remove(self)
+        if self._streamed_device != device:
+            _make_room_on_gpu(device, self._streamed_bytes)
+            with safe_open(self._streamed_file, framework='pt', device=str(device)) as weights:
+                for name, parameter in self.named_parameters():
+                    if name in self._streamed_names:
+                        parameter.data = weights.get_tensor(name).to(parameter.dtype)
+            self._streamed_device = device
+        return original_to(*args, **kwargs)   # Moves the small unstreamed parameters and buffers
+
+    model.to = types.MethodType(to, model)
+    model.cpu = types.MethodType(lambda self: self.to('cpu'), model)
+    model.cuda = types.MethodType(lambda self, device=None: self.to(torch.device('cuda', device) if isinstance(device, int) else (device or 'cuda')), model)
+
+
+def _free_streamed_weights(model) -> None:
+    import torch
+    for name, parameter in model.named_parameters():
+        if name in model._streamed_names:
+            parameter.data = torch.empty(0, dtype=parameter.dtype)   # A placeholder; the weights live in the file
+    model._streamed_device = None
+
+
+def _make_room_on_gpu(device, network_bytes: int) -> None:
+    import os
+    import torch
+    headroom = float(os.environ.get('TRELLIS_VRAM_HEADROOM_GIB', 10)) * 2**30
+    while _idle_gpu_networks:
+        free, _ = torch.cuda.mem_get_info(device)
+        if free >= network_bytes + headroom:
+            return
+        _free_streamed_weights(_idle_gpu_networks.pop(0))
+        torch.cuda.empty_cache()
+
+
